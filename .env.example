# ──────────────────────────────────────────────────────────
# BLOCKCHAIN CONFIGURATION
# ──────────────────────────────────────────────────────────

# Blockchain Network (sepolia, mainnet, polygon, mumbai)
BLOCKCHAIN_NETWORK=sepolia

# Smart Contract Address (sau khi deploy)
# Thay thế bằng địa chỉ contract của bạn
VIOLATION_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Private Key (KHÔNG SHARE - chỉ cho testing)
# Lấy từ MetaMask: Settings > Security & Privacy > Show Private Key
# CHỈ DÙNG VÀ PRIVATE KEY CÓ SÃN CHO TESTING
PRIVATE_KEY=

# Infura API Key (để kết nối blockchain)
INFURA_API_KEY=9aa3d95b3bc440fa88ea12eaa4456161

# ──────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ──────────────────────────────────────────────────────────

DATABASE_URL=sqlite:///vehicle_detection.db

# ──────────────────────────────────────────────────────────
# WEB SERVER CONFIGURATION
# ──────────────────────────────────────────────────────────

FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here

# ──────────────────────────────────────────────────────────
# METAMASK CONFIGURATION
# ──────────────────────────────────────────────────────────

# Network ID (1=mainnet, 11155111=sepolia, 137=polygon, 80001=mumbai)
METAMASK_NETWORK_ID=11155111

# Testnet ETH Faucet URL (để lấy test ETH)
# Sepolia: https://www.sepoliafaucet.io/
# Mumbai: https://faucet.polygon.technology/
TESTNET_FAUCET_URL=https://www.sepoliafaucet.io/
